<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ESPOnBoarding" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="colorPrimary">@color/purple_500</item>

        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->


        <!--<item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
     -->   <item name="android:windowFullscreen">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimaryDark">@color/light_grey_ec</item>

        <!-- Customize your theme here. -->
        <item name="android:windowLightStatusBar">true</item>

    </style>

    <style name="TextInputStyle" parent="Theme.ESPOnBoarding">
        <item name="colorPrimary">@color/grey_BC</item>
        <item name="colorOnSurface">@color/grey_BC</item>
    </style>
  <!--  <style name="statusbar" parent="Theme.ESPOnBoarding">
        <item name="android:statusBarColor">@color/purple_200</item>

    </style>-->

</resources>