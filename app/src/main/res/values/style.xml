<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="otpCornerStyle" parent="@style/Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/allsidecorner</item>
    </style>

    <style name="otpsheetDialogTheme" parent="@style/Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="bottomSheetStyle">@style/otpCornerStyle</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
    </style>

    <style name="custombutton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">@dimen/_10DP</item>
        <item name="android:textSize">@dimen/_20SP</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="headingTop" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">@dimen/_20SP</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="subheading" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/light_blue</item>
        <item name="android:textSize">@dimen/_20SP</item>
        <item name="fontFamily">@font/roboto_medium</item>
    </style>

    <style name="textView" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/lighter_grey</item>
        <item name="android:textSize">@dimen/_18SP</item>
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <style name="CornerCut" parent="">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerFamilyBottomLeft">rounded</item>
        <item name="cornerFamilyBottomRight">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/_10DP</item>
        <item name="cornerSizeTopRight">@dimen/_10DP</item>
        <item name="cornerSizeBottomLeft">@dimen/_10DP</item>
        <item name="cornerSizeBottomRight">@dimen/_10DP</item>
    </style>

    <style name="TextInputLayoutStyle">
        <item name="errorEnabled">true</item>
        <item name="hintEnabled">false</item>
        <item name="background">@color/transparent</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="ThemeOverlay.AppTheme.TextInputEditText.Outlined" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="colorControlActivated">@color/black_1A</item>
        <item name="colorControlHighlight">@color/black_1A</item>
        <item name="colorAccent">@color/black_1A</item>
    </style>

</resources>