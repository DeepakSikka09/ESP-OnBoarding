<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="landing"
            type="com.ecomexpress.oneBoarding.ui.onBoard.viewmodel.LandingViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/light_grey_ec"
        app:layout_constraintTop_toTopOf="parent"
        tools:context=".ui.onBoard.activity.LandingActivity">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_0DP"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent=".35" />

                <include
                    android:id="@+id/common_bg"
                    layout="@layout/header_ecom_express" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPager2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_0DP"
                    android:layout_marginStart="@dimen/_26DP"
                    android:layout_marginTop="@dimen/_20DP"
                    android:layout_marginEnd="@dimen/_26DP"
                    app:layout_constraintBottom_toTopOf="@id/guideline"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/common_bg" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/NoImageiv"
                    android:layout_width="@dimen/_100DP"
                    android:layout_height="@dimen/_80DP"
                    android:src="@drawable/ic_no_image"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/dotsLinearLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/dotsLinearLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_10DP"
                    android:background="@color/transparent"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/viewPager2" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_minimum_title"
                    style="@style/headingTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_10DP"
                    android:layout_marginTop="@dimen/_15DP"
                    android:background="@color/light_grey_ec"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/minimum_per_day_income_guaranteed"
                    android:textSize="@dimen/_24SP"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dotsLinearLayout" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/const_bt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20DP"
                    android:background="@color/light_grey_ec"
                    app:layout_constraintStart_toStartOf="@+id/tv_minimum_title"
                    app:layout_constraintTop_toBottomOf="@+id/tv_minimum_title">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_effort_earning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5DP"
                        android:layout_marginEnd="@dimen/_10DP"
                        android:src="@drawable/ic_effort"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_effort_based"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_effort_based" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_effort_based"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10DP"
                        android:layout_marginTop="@dimen/_5DP"
                        android:fontFamily="@font/roboto_medium"
                        android:padding="@dimen/_2DP"
                        android:text="@string/effort_based_earning"
                        android:textColor="@color/black_b1"
                        android:textSize="@dimen/_17SP"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_weekly_payment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_10DP"
                        android:foregroundGravity="center"
                        android:src="@drawable/ic_weekly_payment"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_weekly_payments"
                        app:layout_constraintEnd_toStartOf="@+id/tv_weekly_payments"
                        app:layout_constraintTop_toTopOf="@+id/tv_weekly_payments">

                    </androidx.appcompat.widget.AppCompatImageView>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_weekly_payments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20DP"
                        android:fontFamily="@font/roboto_medium"
                        android:padding="@dimen/_2DP"
                        android:text="@string/weekly_payments"
                        android:textColor="@color/black_b1"
                        android:textSize="@dimen/_17SP"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/tv_effort_based"
                        app:layout_constraintTop_toBottomOf="@+id/tv_effort_based" />


                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_flexible_time_slot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_10DP"
                        android:src="@drawable/ic_time"
                        app:layout_constraintBottom_toBottomOf="@id/tv_flexible_time_slot"
                        app:layout_constraintEnd_toStartOf="@+id/tv_flexible_time_slot"
                        app:layout_constraintTop_toTopOf="@+id/tv_flexible_time_slot">

                    </androidx.appcompat.widget.AppCompatImageView>


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_flexible_time_slot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20DP"
                        android:fontFamily="@font/roboto_medium"
                        android:padding="@dimen/_2DP"
                        android:text="@string/flexible_time_slot"
                        android:textColor="@color/black_b1"
                        android:textSize="@dimen/_17SP"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/tv_weekly_payments"
                        app:layout_constraintTop_toBottomOf="@+id/tv_weekly_payments" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/Join_btn"
                    style="@style/custombutton"
                    android:layout_marginStart="@dimen/_30DP"
                    android:layout_marginEnd="@dimen/_30DP"
                    android:background="@drawable/button"
                    android:text="@string/Join_As_Ecom_Agent"
                    android:textColor="@color/white"
                    app:layout_constraintBottom_toBottomOf="@+id/signing_text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/const_bt" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/Login_btn"
                    style="@style/custombutton"
                    android:layout_marginStart="@dimen/_30DP"
                    android:layout_marginTop="@dimen/_20DP"
                    android:layout_marginEnd="@dimen/_30DP"
                    android:background="@drawable/curved_rectangle_light_blue"
                    android:backgroundTint="@color/white"
                    android:enabled="false"
                    android:text="@string/login_as_ecom_agent"
                    android:textColor="@color/text_color_sky_blue"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/Join_btn" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/signing_text"
                    style="@style/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20DP"
                    android:gravity="center"
                    android:text="@string/by_signing_up_you_agree_with"
                    android:textSize="@dimen/_16SP"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/Login_btn" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/signing_text">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/terms_condition"
                        style="@style/textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/terms_of_service"
                        android:textColor="@color/light_blue_1"
                        android:textSize="@dimen/_16SP"
                        app:layout_constraintBottom_toTopOf="@+id/and_AppCompatTextView"
                        app:layout_constraintEnd_toStartOf="@+id/and_AppCompatTextView"
                        app:layout_constraintTop_toBottomOf="@+id/and_AppCompatTextView" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/and_AppCompatTextView"
                        style="@style/textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5DP"
                        android:gravity="center"
                        android:text="@string/and"
                        android:textSize="@dimen/_16SP"
                        app:layout_constraintBottom_toTopOf="@id/terms_condition"
                        app:layout_constraintStart_toEndOf="@id/terms_condition"
                        app:layout_constraintTop_toBottomOf="@id/terms_condition" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/privacy_policy"
                        style="@style/textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5DP"
                        android:gravity="center"
                        android:text="@string/privacy_policy"
                        android:textColor="@color/light_blue_1"
                        android:textSize="@dimen/_16SP"
                        app:layout_constraintBottom_toTopOf="@id/and_AppCompatTextView"
                        app:layout_constraintStart_toEndOf="@id/and_AppCompatTextView"
                        app:layout_constraintTop_toBottomOf="@id/and_AppCompatTextView" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_version"
                    style="@style/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8DP"
                    android:layout_marginBottom="@dimen/_10DP"
                    android:textColor="@color/grey_7F"
                    android:textSize="@dimen/_12SP"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
