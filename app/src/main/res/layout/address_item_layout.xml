<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_address_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10DP"
        android:background="@drawable/curved_rectangle_light_blue">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/first_text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10DP"
            android:layout_marginTop="@dimen/_10DP"
            android:layout_marginEnd="@dimen/_10DP"
            android:fontFamily="@font/roboto_regular"
            android:backgroundTint="@color/blue_FF"
            android:gravity="start"
            android:padding="@dimen/_5DP"
            android:textColor="@color/light_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_kilometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/location_buttton"
            android:paddingStart="@dimen/_5DP"
            android:paddingEnd="@dimen/_3DP"
            android:text="@string/_2_5_km"
            android:textColor="@color/purple"
            app:fontFamily="@font/roboto_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/first_text1" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>