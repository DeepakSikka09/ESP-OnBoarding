<?xml version="1.0" encoding="UTF-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cont_Select_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_language"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_8DP"
            app:cardBackgroundColor="@color/blue_FF"
            app:cardCornerRadius="@dimen/_10DP"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_10DP">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/radio_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_10DP"
                    android:src="@drawable/language_unselect"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!--   <androidx.appcompat.widget.AppCompatRadioButton
                       android:id="@+id/radio_btn"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_margin="@dimen/_10DP"
                       android:buttonTint="@color/blue"
                       android:checked="false"
                       android:enabled="false"
                       android:gravity="center"
                       app:layout_constraintBottom_toBottomOf="parent"
                       app:layout_constraintStart_toStartOf="parent"
                       app:layout_constraintTop_toTopOf="parent" />-->

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvLang1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_18DP"
                    android:fontFamily="@font/roboto_medium"
                    android:maxLines="1"
                    android:text="@string/English"
                    android:textSize="@dimen/_20SP"
                    app:layout_constraintBottom_toTopOf="@+id/tvLang2"
                    app:layout_constraintStart_toEndOf="@id/radio_btn"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvLang2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:maxLines="1"
                    android:text="@string/English"
                    android:textColor="@color/text_color_black1"
                    android:textSize="@dimen/_20SP"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tvLang1"
                    app:layout_constraintTop_toBottomOf="@+id/tvLang1" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_lang"
                    android:layout_width="@dimen/_60DP"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_20DP"
                    android:foregroundGravity="center"
                    android:src="@drawable/english_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>



